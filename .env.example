# NIVARA Configuration
# Copy this file to .env and fill in your values

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Dataset paths
QR_DATASET_PATH=data/qr
URL_DATASET_PATH=data/url

# ML paths
ML_DATA_PATH=ml/data
ML_MODELS_PATH=ml/saved_models

# Threat intelligence (Phase 3B)
THREAT_INTEL_OPENPHISH_ENABLED=true
THREAT_INTEL_TIMEOUT_SECONDS=5
THREAT_INTEL_CACHE_TTL_SECONDS=43200
